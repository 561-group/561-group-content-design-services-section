% --- Semantic callouts ------------------------------------------------------
\newtcolorbox{specbox}[1][]{
  enhanced,breakable,sharp corners,boxrule=0.8pt,
  colback=FSOPaperWhite,colframe=FSOInk,
  borderline west={4pt}{0pt}{FSOInk},
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\FSOEvidence\bfseries\fontsize{8}{10}\selectfont,
  title={NORMATIVE},#1
}
\newtcolorbox{evidencebox}[1][]{
  enhanced,breakable,sharp corners,boxrule=0.6pt,
  colback=FSOPaperWhite,colframe=FSORule,
  borderline west={4pt}{0pt}{FSOWitness},
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\FSOEvidence\bfseries\fontsize{8}{10}\selectfont,
  title={EVIDENCE / RATIONALE},#1
}
\newtcolorbox{alarmbox}[1][]{
  enhanced,breakable,sharp corners,boxrule=0.6pt,
  colback=FSOPaperWhite,colframe=FSORule,
  borderline west={4pt}{0pt}{FSOAlarm},
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\FSOEvidence\bfseries\fontsize{8}{10}\selectfont,
  title={EXCEPTION / CONSEQUENCE},#1
}
\newtcolorbox{examplebox}[1][]{
  enhanced,breakable,sharp corners,boxrule=0.4pt,
  colback=FSOBone!65!white,colframe=FSORule,
  left=10pt,right=10pt,top=8pt,bottom=8pt,
  fonttitle=\FSOEvidence\bfseries\fontsize{8}{10}\selectfont,
  title={EXAMPLE},#1
}

