  \definecolor{FSOBone}{HTML}{F2EAD8}%
  \definecolor{FSOWitness}{HTML}{3D5588}%
  \definecolor{FSOAlarm}{HTML}{FF4530}%
  \definecolor{FSOInkSoft}{HTML}{494742}%
