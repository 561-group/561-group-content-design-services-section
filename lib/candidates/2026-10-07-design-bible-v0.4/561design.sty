  pdfkeywords={561 Group, visual design, design system, LaTeX, TUFTE, design tokens}
}
\urlstyle{same}

% Minimal shell-language listing profile; avoids depending on an optional listings
% language module in lean TeX installations.
\lstdefinelanguage{bash}{
  morekeywords={if,then,else,fi,for,in,do,done,case,esac,function,export,cd,make,git,Rscript,latexmk,qpdf,pdfinfo,pdffonts,sha256sum},
  sensitive=true,
  morecomment=[l]{\#},
  morestring=[b]"
}

% --- Hierarchy --------------------------------------------------------------
\titleformat{\chapter}[display]
  {\color{FSOInk}\FSODisplay\bfseries}
  {\FSOEvidence\fontsize{9}{11}\selectfont\color{FSOWitness}\MakeUppercase{Section \thechapter}}
  {6pt}
  {\fontsize{32}{31}\selectfont\raggedright}
  [\vspace{10pt}\color{FSOInk}\rule{\textwidth}{2.2pt}]
\titlespacing*{\chapter}{0pt}{-5pt}{24pt}

\titleformat{\section}
  {\FSODisplay\bfseries\fontsize{18}{20}\selectfont\color{FSOInk}\raggedright}
  {\thesection}{0.7em}{}
\titlespacing*{\section}{0pt}{2.1em}{0.8em}

\titleformat{\subsection}
  {\FSOEvidence\bfseries\fontsize{10}{12}\selectfont\color{FSOInk}\MakeUppercase}
  {\thesubsection}{0.8em}{}
\titlespacing*{\subsection}{0pt}{1.7em}{0.6em}

\titleformat{\subsubsection}
  {\FSODisplay\bfseries\fontsize{11}{13}\selectfont\color{FSOInk}}
  {\thesubsubsection}{0.7em}{}
\titlespacing*{\subsubsection}{0pt}{1.4em}{0.4em}

