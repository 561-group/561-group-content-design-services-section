% --- Typeface channels -------------------------------------------------------
% 561's recovered web implementation names Space Grotesk, Roboto Slab and
% JetBrains Mono. We do not fetch fonts during document rendering. Each channel
% therefore has an explicit locally-available fallback for reproducible builds.
\IfFontExistsTF{Space Grotesk}{\newfontfamily\FSODisplay{Space Grotesk}}{\newfontfamily\FSODisplay{DejaVu Sans}}
\IfFontExistsTF{Roboto Slab}{\newfontfamily\FSOReading{Roboto Slab}}{\newfontfamily\FSOReading{DejaVu Serif}}
\IfFontExistsTF{JetBrains Mono}{\newfontfamily\FSOEvidence{JetBrains Mono}}{\newfontfamily\FSOEvidence{DejaVu Sans Mono}}

\IfFontExistsTF{Roboto Slab}{\setmainfont{Roboto Slab}}{\setmainfont{DejaVu Serif}}
\IfFontExistsTF{Space Grotesk}{\setsansfont{Space Grotesk}}{\setsansfont{DejaVu Sans}}
\IfFontExistsTF{JetBrains Mono}{\setmonofont{JetBrains Mono}}{\setmonofont{DejaVu Sans Mono}}

% --- Page geometry ----------------------------------------------------------
\geometry{a4paper,inner=22mm,outer=38mm,top=20mm,bottom=24mm,headsep=6mm,footskip=12mm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{0.62em plus 0.08em minus 0.04em}
\linespread{1.04}
\emergencystretch=2em
\widowpenalty=10000
\clubpenalty=10000

% --- Base color and PDF behavior -------------------------------------------
\pagecolor{FSOBone}
\color{FSOInk}
\hypersetup{
  colorlinks=true,
