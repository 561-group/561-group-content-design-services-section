% --- Deterministic visual primitives ---------------------------------------
\newcommand{\FSOColorChip}[3]{%
  \begin{tikzpicture}[baseline=(label.base)]
    \fill[#1] (0,0) rectangle (1.45,0.55);
    \draw[FSOInk,line width=.35pt] (0,0) rectangle (1.45,0.55);
    \node[anchor=west] (label) at (1.62,0.29) {\begin{minipage}{0.55\linewidth}\FSODisplay\bfseries #2\\[-1pt]{\FSOEvidence\fontsize{7}{8}\selectfont #3}\end{minipage}};
  \end{tikzpicture}%
}

\newcommand{\FSOSectionPlate}[3]{%
  \begin{tikzpicture}
    \fill[FSOPaperWhite] (0,0) rectangle (\textwidth,4.15);
    \fill[#1] (0,0) rectangle (0.32,4.15);
    \node[anchor=west,text width=.82\textwidth] at (0.75,3.55) {\FSOLabel{#2}};
    \node[anchor=west,text width=.82\textwidth] at (0.75,2.05) {\FSODisplay\bfseries\fontsize{22}{24}\selectfont #3};
    \draw[FSORule] (0.75,0.55) -- (\textwidth-0.5,0.55);
  \end{tikzpicture}%
}

