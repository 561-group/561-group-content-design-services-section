{
  "$description": "Portable visual-design tokens for 561 Group Design Bible v0.3.",
  "$extensions": {
    "org.561.group": {
      "format": "Design Tokens Community Group Format Module 2025.10",
      "edition": "v0.3",
      "source": "content/text/documents/articles/specifications/561-group-design-bible.md"
    }
  },
  "color": {
    "$type": "color",
    "ink": {
      "$description": "Structural mark-bearing ink.",
      "$value": { "colorSpace": "srgb", "components": [0.0392156863, 0.0392156863, 0.0392156863], "alpha": 1, "hex": "#0A0A0A" }
    },
    "ink-soft": {
      "$description": "Secondary text on bone paper.",
      "$value": { "colorSpace": "srgb", "components": [0.1803921569, 0.1647058824, 0.1411764706], "alpha": 1, "hex": "#2E2A24" }
    },
    "bone": {
      "$description": "Paper ground.",
      "$value": { "colorSpace": "srgb", "components": [0.9490196078, 0.9176470588, 0.8470588235], "alpha": 1, "hex": "#F2EAD8" }
    },
    "bone-deep": {
      "$value": { "colorSpace": "srgb", "components": [0.9019607843, 0.862745098, 0.768627451], "alpha": 1, "hex": "#E6DCC4" }
    },
    "bone-edge": {
      "$value": { "colorSpace": "srgb", "components": [0.8470588235, 0.8039215686, 0.6980392157], "alpha": 1, "hex": "#D8CDB2" }
    },
    "alarm": {
      "$description": "Hazard or urgency; budgeted at no more than six percent of inked area.",
      "$value": { "colorSpace": "srgb", "components": [1, 0.2705882353, 0.1882352941], "alpha": 1, "hex": "#FF4530" }
    },
    "witness": {
      "$description": "Evidence; budgeted at no more than three percent of inked area.",
      "$value": { "colorSpace": "srgb", "components": [0.2392156863, 0.3333333333, 0.5333333333], "alpha": 1, "hex": "#3D5588" }
    }
  },
  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Space Grotesk", "Helvetica Neue", "Arial", "sans-serif"] },
      "slab": { "$type": "fontFamily", "$value": ["Roboto Slab", "Rockwell", "Georgia", "serif"] },
      "mono": { "$type": "fontFamily", "$value": ["JetBrains Mono", "ui-monospace", "Courier New", "monospace"] }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    }
  },
  "space": {
    "$type": "dimension",
    "0": { "$value": { "value": 0, "unit": "px" } },
    "1": { "$value": { "value": 4, "unit": "px" } },
    "2": { "$value": { "value": 8, "unit": "px" } },
    "3": { "$value": { "value": 14, "unit": "px" } },
    "4": { "$value": { "value": 24, "unit": "px" } },
    "5": { "$value": { "value": 48, "unit": "px" } },
    "6": { "$value": { "value": 80, "unit": "px" } },
    "7": { "$value": { "value": 120, "unit": "px" } }
  },
  "layout": {
    "web": {
      "gutter": { "$type": "dimension", "$value": { "value": 56, "unit": "px" } },
      "design-bible-max": { "$type": "dimension", "$value": { "value": 1320, "unit": "px" } },
      "semantic-site-max": { "$type": "dimension", "$value": { "value": 1200, "unit": "px" } },
      "measure": { "$type": "dimension", "$value": { "value": 42, "unit": "rem" } }
    }
  },
  "type": {
    "display-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.sans}",
        "fontSize": { "value": 128, "unit": "px" },
        "fontWeight": "{font.weight.bold}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 0.85
      }
    },
    "body-1": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.slab}",
        "fontSize": { "value": 16, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.5
      }
    },
    "metadata": {
      "$type": "typography",
      "$value": {
        "fontFamily": "{font.family.mono}",
        "fontSize": { "value": 11, "unit": "px" },
        "fontWeight": "{font.weight.regular}",
        "letterSpacing": { "value": 0, "unit": "px" },
        "lineHeight": 1.4
      }
    }
  }
}
